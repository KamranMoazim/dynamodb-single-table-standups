ckgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#ffffff;entryX=0.5;entryY=1;" edge="1" parent="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="352"/></Array></mxGeometry></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0;entryY=0.25;" edge="1" parent="1" source="c23" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="245"/><mxPoint x="1030" y="480"/></Array></mxGeometry></mxCell><mxCell id="c51" value="5 GSI3 queries" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="c25" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="352"/><mxPoint x="1030" y="480"/></Array></mxGeometry></mxCell><mxCell id="c52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c27" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c29" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="7 stream: new check-ins" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;" edge="1" parent="1" source="c19" target="c33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1332" y="495"/></Array></mxGeometry></mxCell><mxCell id="c55" value="STATS#t" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.85;" edge="1" parent="1" source="c33" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1230" y="752"/><mxPoint x="1230" y="540"/></Array></mxGeometry></mxCell><mxCell id="c56" value="&lt;b&gt;Flow&lt;/b&gt;&lt;br&gt;1 Static site and config.json from CloudFront&lt;br&gt;2 Email + password sign in returns an ID token&lt;br&gt;3 Every API call carries the token&lt;br&gt;4 One or two table calls per screen&lt;br&gt;5 Scheduled Lambdas query the sparse GSI3&lt;br&gt;6 Emails go through SQS to the sender and SES&lt;br&gt;7 New check-ins stream to the stats Lambda" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#F2F3F3;strokeColor=none;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="520" height="175" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;Single table: standuplog&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;USER#u&lt;/font&gt; PROFILE, WS#w, TEAM#t, STATS#t&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;WS#w&lt;/font&gt; META, MEMBER#u, TEAM#t &amp;nbsp; &lt;font face=&quot;Menlo&quot;&gt;INVITE#code&lt;/font&gt; META&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;TEAM#t&lt;/font&gt; META, MEMBER#u, DAY#date#USER#u (+ #C# comments, #R# reactions)&lt;br&gt;&lt;b&gt;GSI1&lt;/b&gt; USER#u by date: history &amp;nbsp; &lt;b&gt;GSI2&lt;/b&gt; BLOCKERS#t, sparse&lt;br&gt;&lt;b&gt;GSI3&lt;/b&gt; keys only, sparse: REMIND#HH:MM slots and DIGEST team list" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#F5EAFB;strokeColor=#C925D1;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="580" y="920" width="560" height="175" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;Design rules&lt;/b&gt;&lt;br&gt;Access patterns first; keys follow from them.&lt;br&gt;One Query returns a whole team-day feed.&lt;br&gt;Sparse indexes: a resolved blocker leaves GSI2.&lt;br&gt;No per-hour resources: no VPC, NAT, KMS key or secrets.&lt;br&gt;Strong reads only for your own check-in after submit." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#232F3E;strokeColor=none;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1160" y="920" width="400" height="175" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>